{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wibias/agent-hub/tests/memory-ratchet/receipt.schema.json",
  "title": "Memory Ratchet Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "candidate",
    "adapter",
    "fixture_revision",
    "mode",
    "case_id",
    "verdict",
    "assertions",
    "configuration",
    "metrics"
  ],
  "properties": {
    "spec_version": { "const": "0.1.0" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "deviations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "fixture_revision": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["core", "native"] },
    "case_id": { "pattern": "^M(0[1-9]|1[0-5])$" },
    "verdict": { "enum": ["pass", "fail", "blocked"] },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "required": ["network_required"],
      "properties": {
        "network_required": { "type": "boolean" },
        "llm_model": { "type": ["string", "null"] },
        "embedding_model": { "type": ["string", "null"] },
        "reranker_model": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingest_latency_ms",
        "recall_latency_ms",
        "persisted_bytes",
        "recall_payload_bytes",
        "memory_items_returned",
        "llm_calls",
        "embedding_calls",
        "reranker_calls"
      ],
      "properties": {
        "ingest_latency_ms": { "type": "number", "minimum": 0 },
        "recall_latency_ms": { "type": "number", "minimum": 0 },
        "process_rss_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "persisted_bytes": { "type": "integer", "minimum": 0 },
        "recall_payload_bytes": { "type": "integer", "minimum": 0 },
        "memory_items_returned": { "type": "integer", "minimum": 0 },
        "llm_calls": { "type": "integer", "minimum": 0 },
        "embedding_calls": { "type": "integer", "minimum": 0 },
        "reranker_calls": { "type": "integer", "minimum": 0 },
        "background_services": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "raw_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "notes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "redactions": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
