<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <UseAppHost>true</UseAppHost>
    <AssemblyName>AgentHub.C9.ReadOnlyBroker.RC2</AssemblyName>
    <Version>0.2.0-rc.2</Version>
  </PropertyGroup>
  <Target Name="RejectWriter" BeforeTargets="PrepareForBuild" Condition="'$(EnableLabCommit)' == 'true' Or '$(EnableWriteCommit)' == 'true'">
    <Error Text="C9 RC2 is read-only. Writer/commit build switches are forbidden." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../g2-kernel-review/src/AgentHub.C9.G2.KernelReview.csproj" />
    <Compile Include="../../readonly-rc1/src/Broker/BrokerIdentity.cs" Link="BrokerIdentity.cs" />
    <Compile Include="../../readonly-rc1/src/Broker/Native.cs" Link="Native.cs" />
    <Compile Include="../../readonly-rc1/src/Broker/ReadOnlyPolicy.cs" Link="ReadOnlyPolicy.cs" />
    <Compile Include="../../readonly-rc1/src/Broker/BrokerRequestRouter.cs" Link="BrokerRequestRouter.cs" />
    <Compile Include="BrokerRc2Route.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
