{
  "version": 1,
  "hosts": {
    "cursor": {
      "displayName": "Cursor",
      "reviewed": "2026-09-04",
      "sources": [
        "https://cursor.com/docs/skills",
        "https://cursor.com/docs/subagents"
      ],
      "skills": {
        "agentsRoot": true,
        "sharedSkillRoot": "~/.agents/skills",
        "skillModelRouting": false
      },
      "agentProfiles": {
        "supported": true,
        "nativeRoot": ".cursor/agents",
        "compatibleRoots": [
          ".claude/agents",
          ".codex/agents"
        ]
      },
      "adapter": {
        "configRenderer": "unsupported",
        "note": "Cursor model selection belongs to agent profiles rather than portable skill frontmatter. A Hub renderer is intentionally not implemented until the exact desired profile schema and ownership are locked."
      }
    },
    "grok": {
      "displayName": "Grok Build",
      "reviewed": "2026-09-04",
      "sources": [
        "https://docs.x.ai/build/features/skills-plugins-marketplaces"
      ],
      "skills": {
        "agentsRoot": true,
        "sharedSkillRoot": "~/.agents/skills",
        "skillModelRouting": false
      },
      "agentProfiles": {
        "supported": true,
        "compatibleRoots": [
          ".claude/agents"
        ]
      },
      "adapter": {
        "configRenderer": "unsupported",
        "note": "Grok documents that model/effort fields in skill frontmatter are not applied. Keep routing outside shared skills."
      }
    },
    "claude": {
      "displayName": "Claude Code",
      "reviewed": "2026-10-03",
      "sources": [
        "https://code.claude.com/docs/en/hooks",
        "https://github.com/addyosmani/agent-skills/blob/main/docs/advanced-per-agent-configuration.md"
      ],
      "skills": {
        "agentsRoot": false,
        "skillModelRouting": false
      },
      "agentProfiles": {
        "supported": "manual"
      },
      "adapter": {
        "configRenderer": "unsupported",
        "note": "General Claude Code host-config rendering remains unsupported. Documented lifecycle command hooks are supported; the read-only memory integration uses UserPromptSubmit through the explicit Claude Code hook adapter."
      },
      "hooks": {
        "supported": true,
        "command": true,
        "pluginBundled": true,
        "events": [
          "SessionStart",
          "UserPromptSubmit",
          "PreToolUse",
          "PermissionRequest",
          "PostToolUse",
          "PreCompact",
          "PostCompact",
          "SubagentStart",
          "SubagentStop",
          "Stop",
          "SessionEnd"
        ]
      }
    },
    "codex": {
      "displayName": "OpenAI Codex",
      "reviewed": "2026-10-03",
      "sources": [
        "https://developers.openai.com/docs/config-file/config-reference",
        "https://developers.openai.com/docs/config-file/config-basic",
        "https://developers.openai.com/docs/hooks",
        "https://developers.openai.com/plugins/build/plugins"
      ],
      "skills": {
        "agentsRoot": true,
        "sharedSkillRoot": "~/.agents/skills",
        "skillModelRouting": false
      },
      "agentProfiles": {
        "supported": "manual"
      },
      "adapter": {
        "configRenderer": "supported",
        "mappedRuntimeFields": [
          "reasoning"
        ],
        "note": "Codex profile rendering is supported for the verified 1:1 mapping reasoning -> model_reasoning_effort. Skill-to-profile activation remains manual because skillModelRouting is unsupported. Isolation and mutation remain semantic Hub preferences and are emitted only as unmapped metadata/comments, not translated to sandbox or approval settings."
      },
      "hooks": {
        "supported": true,
        "command": true,
        "pluginBundled": true,
        "events": [
          "SessionStart",
          "PreToolUse",
          "PermissionRequest",
          "PostToolUse",
          "PreCompact",
          "PostCompact",
          "UserPromptSubmit",
          "SubagentStart",
          "SubagentStop",
          "Stop",
          "Interrupt",
          "SessionEnd"
        ]
      }
    }
  }
}
