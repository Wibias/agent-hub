{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub:design-references:pattern-schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "problem",
    "worksWhen",
    "failsWhen",
    "examples",
    "counterexamples",
    "evidenceStrength",
    "lastSynthesizedAt",
    "tags",
    "reviewStatus",
    "synthesizedBy",
    "reviewedBy",
    "reviewedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pattern-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "problem": {
      "type": "string",
      "minLength": 8
    },
    "worksWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failsWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ref-"
      }
    },
    "counterexamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ref-"
      }
    },
    "evidenceStrength": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "lastSynthesizedAt": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "string"
      }
    },
    "reviewStatus": {
      "enum": [
        "candidate",
        "reviewed",
        "stale",
        "archived"
      ]
    },
    "synthesizedBy": {
      "type": "string",
      "minLength": 2
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
