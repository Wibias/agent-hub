{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub:design-references:reference-schema",
  "title": "Design reference record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "canonicalUrl",
    "product",
    "surfaceFamily",
    "primaryStratum",
    "platform",
    "flowStates",
    "evidenceClass",
    "accessStatus",
    "accessMethod",
    "storagePolicy",
    "pageRole",
    "firstScreenJob",
    "topology",
    "traversal",
    "density",
    "responsiveBehavior",
    "motion",
    "visualWorld",
    "strengths",
    "weaknesses",
    "transferableDecisions",
    "tags",
    "sourceFamily",
    "sourceKind",
    "observedAt",
    "lastVerifiedAt",
    "ttlDays",
    "reviewStatus",
    "researchedBy",
    "reviewedBy",
    "reviewedAt",
    "rightsNote",
    "provenanceNote",
    "ordinaryOrFailureProne",
    "multiStateFlow",
    "replacementFor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ref-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "product": {
      "type": "string",
      "minLength": 2
    },
    "surfaceFamily": {
      "type": "string"
    },
    "primaryStratum": {
      "enum": [
        "direct-domain",
        "adjacent-domain",
        "outside-domain",
        "evidence-craft"
      ]
    },
    "platform": {
      "enum": [
        "web-responsive",
        "native-mobile"
      ]
    },
    "flowStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceClass": {
      "enum": [
        "TESTED",
        "OBSERVED",
        "INTERPRETED",
        "INSPIRATION",
        "MARKETING_CLAIM"
      ]
    },
    "accessStatus": {
      "enum": [
        "AVAILABLE",
        "PAYWALLED",
        "BLOCKED",
        "UNAVAILABLE"
      ]
    },
    "accessMethod": {
      "type": "string",
      "minLength": 2
    },
    "storagePolicy": {
      "enum": [
        "text-link-only",
        "local-cache-permitted"
      ]
    },
    "pageRole": {
      "type": "string",
      "minLength": 3
    },
    "firstScreenJob": {
      "type": "string",
      "minLength": 3
    },
    "topology": {
      "type": "string",
      "minLength": 3
    },
    "traversal": {
      "type": "string",
      "minLength": 3
    },
    "density": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "responsiveBehavior": {
      "type": "string",
      "minLength": 3
    },
    "motion": {
      "type": "string",
      "minLength": 2
    },
    "visualWorld": {
      "type": "string",
      "minLength": 3
    },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "weaknesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "transferableDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "sourceFamily": {
      "type": "string",
      "minLength": 2
    },
    "sourceKind": {
      "enum": [
        "underlying-product",
        "flow",
        "case-study",
        "guideline",
        "design-system",
        "interaction-example"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date"
    },
    "ttlDays": {
      "enum": [
        30,
        60,
        90,
        180,
        365
      ]
    },
    "reviewStatus": {
      "enum": [
        "candidate",
        "reviewed",
        "stale",
        "archived"
      ]
    },
    "researchedBy": {
      "type": "string",
      "minLength": 2
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "rightsNote": {
      "type": "string",
      "minLength": 3
    },
    "provenanceNote": {
      "type": "string",
      "minLength": 3
    },
    "ordinaryOrFailureProne": {
      "type": "boolean"
    },
    "multiStateFlow": {
      "type": "boolean"
    },
    "replacementFor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
